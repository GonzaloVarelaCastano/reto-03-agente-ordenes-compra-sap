{
  "name": "reto-03-agente-ordenes-compra-sap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run --testTimeout 20000 --exclude \"**/.perxia/**\"",
    "build": "vite build --config web/vite.config.ts && esbuild src/server.ts --bundle --packages=external --platform=node --format=esm --outfile=dist/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "demo": "tsx demo.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.4",
    "@types/node": "24.10.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "4.1.12"
  }
}
