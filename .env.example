# Servidor
PORT=3000
NODE_ENV=development

# LLM: Gemini solo se activa si GEMINI_API_KEY está definida en el servidor.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
GEMINI_API_KEY=
LLM_TIMEOUT_MS=15000
MAX_AGENT_ITERATIONS=25
MAX_SESSION_TOKENS=20000

# Demo pública opcional. Déjelo vacío en desarrollo local sin protección.
APP_ACCESS_TOKEN=
CHAT_RATE_LIMIT=30
